# SentinelAgent configuration (copy to .env)

# Core
SENTINEL_LOG_LEVEL=INFO
SENTINEL_DATABASE_PATH=data/sentinel.db

# ML detection
SENTINEL_DETECTION_TRAIN_WINDOW=100
SENTINEL_DETECTION_Z_WINDOW=60
SENTINEL_ANOMALY_SCORE_THRESHOLD=0.65
SENTINEL_DRIFT_ALPHA=0.10
SENTINEL_DRIFT_WARMUP=120
SENTINEL_ENABLE_LSTM_AE=false

# Agent (optional LLM backend - leave empty to use the built-in rule engine)
SENTINEL_OPENAI_API_KEY=
SENTINEL_LLM_MODEL=gpt-4o-mini

# MQTT (edge broker for real ESP32 sensors)
SENTINEL_MQTT_ENABLED=false
SENTINEL_MQTT_BROKER=localhost
SENTINEL_MQTT_PORT=1883
SENTINEL_MQTT_TOPIC=sentinel/events

# Security (JWT auth - leave disabled for local dev)
SENTINEL_JWT_ENABLED=false
SENTINEL_JWT_SECRET=change-this-to-a-random-string-in-production

# Server
SENTINEL_WS_ORIGIN=*
