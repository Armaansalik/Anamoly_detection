    {"metric": "memory", "severity": "medium", "when": "warn"},
    {"metric": "memory", "severity": "high", "when": "critical"},
    {"metric": "latency_ms", "severity": "medium", "when": "warn"},
    {"metric": "latency_ms", "severity": "high", "when": "critical"}
  ]
